{
  "name": "maihs-site-template",
  "version": "1.0.0",
  "private": true,
  "description": "Plain Next.js website for the MAIHS AI builder: no database, no dashboard, deployed to Cloudflare Workers.",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=4096\" next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "deploy:build": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "generate:types": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "validate:agent": "node --check .agent/server.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.5.0",
    "@hookform/resolvers": "5.4.0",
    "@opennextjs/cloudflare": "1.20.7",
    "@tailwindcss/postcss": "4.3.3",
    "@tanstack/react-table": "8.21.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "cross-env": "7.0.3",
    "date-fns": "4.3.0",
    "embla-carousel-autoplay": "8.6.0",
    "embla-carousel-react": "8.6.0",
    "input-otp": "1.4.2",
    "lenis": "1.3.23",
    "lucide-react": "1.16.0",
    "motion": "12.40.0",
    "next": "16.3.7",
    "next-themes": "0.4.6",
    "postcss": "8.5.15",
    "react": "19.2.8",
    "react-day-picker": "10.0.1",
    "react-dom": "19.2.8",
    "react-hook-form": "7.76.1",
    "react-icons": "5.6.0",
    "react-intersection-observer": "10.0.3",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "4.11.2",
    "recharts": "3.8.0",
    "remark-gfm": "4.0.1",
    "shadcn": "4.8.0",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "usehooks-ts": "3.1.1",
    "vaul": "1.1.2",
    "ws": "8.21.0",
    "zod": "4.4.3",
    "zustand": "5.0.13"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.7",
    "prettier": "3.8.3",
    "typescript": "5.9.3",
    "wrangler": "4.143.0"
  },
  "engines": {
    "node": ">=20.9.0",
    "pnpm": "^10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver",
      "workerd"
    ]
  }
}
