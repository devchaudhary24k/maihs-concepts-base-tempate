# ----------------------------------------------------------------------------
# Copy this file to `.env` and fill in values. `.env` is gitignored.
# Only PAYLOAD_SECRET is required for local development.
# ----------------------------------------------------------------------------

# REQUIRED. Secret used by Payload for JWT / encryption.
# Generate one with:  openssl rand -hex 32
PAYLOAD_SECRET=

# OPTIONAL. Payload log level: trace | debug | info | warn | error | fatal
# Default: info
# PAYLOAD_LOG_LEVEL=info

# OPTIONAL. Selects a wrangler environment (e.g. "staging") for dev/deploy.
# Leave unset to use the default environment.
# CLOUDFLARE_ENV=

# ----------------------------------------------------------------------------
# Deploy-only credentials. NOT needed for local dev or the Docker dev container.
# Used by `wrangler deploy` and remote D1 migrations. Keep secret.
# ----------------------------------------------------------------------------
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
