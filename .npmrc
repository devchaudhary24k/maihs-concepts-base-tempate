legacy-peer-deps=true

# Every dependency in package.json is pinned to an exact version. A floating
# range is what broke deploys before: `@opennextjs/cloudflare: ^1.11.0` silently
# resolved 8 minors forward on an unrelated lockfile regen and landed on a build
# whose peer range no longer matched the pinned wrangler. Keep `pnpm add` from
# reintroducing carets.
save-exact=true
save-prefix=
